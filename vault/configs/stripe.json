{
  "$schema": "../schemas/config.schema.json",
  "name": "stripe",
  "description": "Stripe Node.js SDK documentation. Use for payments, Checkout Sessions, Payment Intents, webhooks, subscriptions, Connect, and TypeScript types.",
  "_source": {
    "type": "github",
    "repo": "stripe/stripe-node",
    "path": ".",
    "extensions": [
      ".md",
      ".ts",
      ".js"
    ],
    "exclude": [
      "**/test/**",
      "**/testProjects/**",
      "**/scripts/**",
      "**/src/resources/**",
      "**/src/platform/**",
      "**/node_modules/**",
      "**/.github/**",
      "**/.claude/**",
      "**/.vscode/**",
      "**/.hark/changes/**",
      "**/.hark/intros/**",
      "**/eslint-rules/**",
      "**/.eslintrc.js",
      "**/.mocharc.js"
    ]
  },
  "versions": {
    "latest": {
      "ref": "master"
    },
    "23.1.0": {
      "ref": "v23.1.0"
    },
    "22.2.1": {
      "ref": "v22.2.1"
    }
  }
}
