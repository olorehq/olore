{
  "$schema": "../schemas/config.schema.json",
  "name": "tanstack-table",
  "description": "TanStack Table documentation. Use for headless table/datagrid UI, sorting, filtering, pagination, grouping, row selection, expanding, and column sizing/pinning/ordering/visibility.",
  "_source": {
    "type": "github",
    "repo": "TanStack/table",
    "path": "docs",
    "extensions": [".md"],
    "exclude": [
      "framework/alpine/**",
      "framework/angular/**",
      "framework/ember/**",
      "framework/lit/**",
      "framework/octane/**",
      "framework/preact/**",
      "framework/qwik/**",
      "framework/solid/**",
      "framework/svelte/**",
      "framework/vue/**"
    ]
  },
  "versions": {
    "latest": { "ref": "main" },
    "9.3.1": { "ref": "@tanstack/react-table@9.3.1" },
    "9.0.0": { "ref": "@tanstack/react-table@9.0.0" },
    "8": { "ref": "v8" },
    "8.21.3": { "ref": "v8.21.3" }
  }
}
