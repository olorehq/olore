{
  "$schema": "../schemas/config.schema.json",
  "name": "tanstack-form",
  "description": "TanStack Form documentation. Use for form state management, validation, field arrays, form composition, field groups, listeners, SSR/server actions, and React form integration.",
  "_source": {
    "type": "github",
    "repo": "TanStack/form",
    "path": "docs",
    "extensions": [".md"],
    "exclude": [
      "framework/angular/**",
      "framework/lit/**",
      "framework/preact/**",
      "framework/solid/**",
      "framework/svelte/**",
      "framework/vue/**"
    ]
  },
  "versions": {
    "latest": { "ref": "main" },
    "1.27.7": { "ref": "@tanstack/react-form@1.27.7" },
    "1.27.6": { "ref": "@tanstack/react-form@1.27.6" }
  }
}
