{
  "name": "@olorehq/olore",
  "version": "0.4.2",
  "description": "Version-pinned docs for AI coding agents. Offline. Local-first.",
  "keywords": [
    "ai",
    "documentation",
    "claude",
    "codex",
    "opencode",
    "coding-assistant",
    "context",
    "llm",
    "skills",
    "agents-md",
    "claude-md"
  ],
  "license": "MIT",
  "author": "olorehq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olorehq/olore.git",
    "directory": "cli"
  },
  "homepage": "https://www.olore.dev",
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "bin": {
    "olore": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "generate-registry": "npx tsx scripts/generate-registry.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fs-extra": "^11.3.3",
    "ora": "^9.0.0",
    "picocolors": "^1.1.1",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.7",
    "prettier": "^3.8.0",
    "prettier-plugin-packagejson": "^2.5.22",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
